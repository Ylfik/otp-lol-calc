|description3 = {{sbc|Recast:}} '''Elise''' and her ''{{ai|Spider Queen|Elise|Spiderlings}}'' reappear and descend onto the ground over {{fd|0.4}} seconds, becoming targetable and able to act again afterwards. Additionally, ''{{ais|Spider Queen|Elise}}'' bonuses are increased for 5 seconds.
|leveling3    = {{st|Spider Effects Increase|{{ap|40 to 100}}%}}
|description4 = If the recast was used on a target enemy, '''Elise''' and her ''{{ai|Spider Queen|Elise|Spiderlings}}'' {{tip|blink|descend}} behind the target's location. Otherwise, she and her ''{{ai|Spider Queen|Elise|Spiderlings}}'' will descend onto their current position without a target.
|description5 = ''Rappel's recast can be used while affected by {{tip|cast-inhibiting crowd control}}.''
|cooldown     = {{ap|22 to 18}}
|cdstart      = post-effect
|target range = {{dv|{{tip|cr|icononly = true}} {{tt|825|Location-targeted recast range, and recast range for descending onto targets with recast input (E2)}}|{{tip|er|icononly=true}} {{tt|900|Recast range for descending onto targets with attack commands (RMB)}}}}
|targeting    = [[Location-targeted|Location]] / [[Unit-targeted|Unit]]
|affects      = Self, Enemies
|cast time    = none
|damagetype   = 
|projectile   = 
|grounded     = true
