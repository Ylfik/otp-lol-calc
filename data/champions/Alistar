|leveling     = {{st|Magic Damage|{{ap|55 to 275}} {{as|(+ 100% AP)}}}}
|target range = {{tip|cr|icononly = true}} {{tt|650|Target range}}
|speed        = {{tt|{{dv|1200|1544}}|See notes}}
